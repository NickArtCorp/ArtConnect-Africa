{
  "name": "artconnect-africa",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:frontend": "cd frontend && npm install --include=dev --legacy-peer-deps",
    "build:frontend": "cd frontend && (test -d node_modules || npm install --include=dev --legacy-peer-deps) && npm run build",
    "lint": "cd frontend && npm run lint",
    "dev": "(test -f frontend/build/index.html || npm run build:frontend) && tsx server.ts",
    "start": "node dist/server.cjs",
    "build": "npm run build:frontend && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "path": "^0.12.7",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.0"
  }
}
